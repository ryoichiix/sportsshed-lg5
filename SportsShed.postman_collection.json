    {
      "name": "TWIST Test 1 - sort name asc",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/kits?sort=name&order=asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "kits"
          ],
          "query": [
            {
              "key": "sort",
              "value": "name"
            },
            {
              "key": "order",
              "value": "asc"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "var n = pm.response.json().map(function(k){return k.name;});",
              "pm.test(\"A to Z\", function () { pm.expect(n).to.eql(n.slice().sort()); });"
            ]
          }
        }
      ]
    },
    {
      "name": "TWIST Test 2 - sort name desc",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
