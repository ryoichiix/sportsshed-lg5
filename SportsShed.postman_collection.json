            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "var n = pm.response.json().map(function(k){return k.name;});",
              "pm.test(\"Z to A\", function () { pm.expect(n).to.eql(n.slice().sort().reverse()); });"
            ]
          }
        }
      ]
